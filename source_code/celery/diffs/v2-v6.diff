+        s = noop.s().set(queue=celery_setup.worker.worker_queue)
+
+        result = s.apply_async(countdown=-5)
+        result.get(timeout=10)
+        assert result.status == "SUCCESS"
+
+    def test_very_short_delay(self, celery_setup: CeleryTestSetup):
