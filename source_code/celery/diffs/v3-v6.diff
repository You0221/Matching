+                self._mapping_data = {}
+
+            def __getitem__(self, key):
+                return self._mapping_data[key]
+
+            def __iter__(self):
+                return iter(self._mapping_data)
+
+            def __len__(self):
+                return len(self._mapping_data)
+
+            def keys(self):
