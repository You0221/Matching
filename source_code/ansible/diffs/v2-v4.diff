+        IPTABLES_CMD,
+        "-t", "filter",
+        "-C", "INPUT",
+        "-p", "tcp",
+        "-j", "ACCEPT",
+        "--destination-port", "80",
+    ]
+
+    second_cmd_args = run_command.call_args_list[1][0][0]
+    assert second_cmd_args == [
+        IP6TABLES_CMD,
+        "-t", "filter",
+        "-C", "INPUT",
+        "-p", "tcp",
+        "-j", "ACCEPT",
+        "--destination-port", "80",
+    ]
