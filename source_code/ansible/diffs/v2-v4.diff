+done
+
+intermediate_user_name="${args[intermediate_user_idx+1]}"
+
+unset "args[intermediate_user_idx]"
+unset "args[intermediate_user_idx+1]"
+
+exec sudo -n -u "${intermediate_user_name}" sudo -k "${args[@]}"
