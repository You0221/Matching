+    mode: "755"
+    path: "{{ temp_file.path }}"
+  register: temp_file
+  diff: false
+  environment:
+    ANSIBLE_DIFF_ALWAYS: True
+
+- name: Confirm diff was not returned in results
+  assert:
+    that:
+      - temp_file.diff is not defined
