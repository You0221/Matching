+            source: /proc/mounts
+            source_data: "binfmt_misc /proc/sys/fs/binfmt_misc binfmt_misc rw,nosuid,nodev,noexec,relatime 0 0"
+          block_available: 0
+          block_size: 4096
+          block_total: 0
+          block_used: 0
+          device: binfmt_misc
+          dump: 0
+          fstype: binfmt_misc
+          inode_available: 0
+          inode_total: 0
