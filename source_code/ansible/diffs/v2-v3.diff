+          ansible_context:
+            source: /proc/mounts
+            source_data: "systemd-1 /proc/sys/fs/binfmt_misc autofs rw,relatime,fd=33,pgrp=1,timeout=0,minproto=5,maxproto=5,direct,pipe_ino=33850 0 0"
+          block_available: 0
+          block_size: 4096
+          block_total: 0
