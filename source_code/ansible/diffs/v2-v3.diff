+
+from __future__ import annotations
+
+import pytest
+
+from ansible.template import Templar
+from ansible.utils.listify import listify_lookup_plugin_terms
+
+from units.mock.loader import DictDataLoader
+
+
+@pytest.mark.parametrize(
+    ("test_input", "expected"),
+    [
