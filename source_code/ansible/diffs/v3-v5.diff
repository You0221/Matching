+        uptime_facts = {}
+        # On AIX, there are no options to get the uptime directly in seconds.
+        # Your options are to parse the output of "who", "uptime", or "ps".
+        # Only "ps" always provides a field with seconds.
+        ps_bin = self.module.get_bin_path("ps")
