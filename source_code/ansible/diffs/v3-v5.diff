+                            handlesToInheritPtr,
+                            IntPtr.Size * 4);
+
+                        if (rawParentProcessHandle != IntPtr.Zero)
+                        {
+                            UpdateProcThreadAttribute(
+                                attrList,
+                                NativeHelpers.PROC_THREAD_ATTRIBUTE_PARENT_PROCESS,
+                                &rawParentProcessHandle,
