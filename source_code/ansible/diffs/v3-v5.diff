+
+    _self__ansible_tags_mapping: _datatag._AnsibleTagsMapping
+
+    def __init__(self, stream: io.IOBase, tags: _datatag.AnsibleDatatagBase | _t.Iterable[_datatag.AnsibleDatatagBase]) -> None:
