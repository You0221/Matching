+                minutes = int(data[2])
+                seconds = int(data[3])
+            except (IndexError, ValueError):
+                return uptime_facts
+            # Calculate uptime in seconds
+            uptime_seconds = (days * 86400) + (hours * 3600) + (minutes * 60) + seconds
+            uptime_facts['uptime_seconds'] = int(uptime_seconds)
+
+        return uptime_facts
