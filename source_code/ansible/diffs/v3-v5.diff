+@dataclasses.dataclass(order=True, slots=True)
+class KeyList(Msg):
+    nkeys: uint32
+    keys: PublicKeyMsgList
+
+    def __post_init__(self) -> None:
+        if self.nkeys != len(self.keys):
+            raise SshAgentFailure("agent: invalid number of keys received for identities list")
+
