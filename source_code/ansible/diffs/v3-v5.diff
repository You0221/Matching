+          - groups.runner | sort == expected_host_names
+          - groups.keys() | sort == expected_group_names
+          # and now some spot checks...
+          - groups.api | length == 6
+          - groups.api_dev | length == 2
+          - groups.build | length == 6
+          - groups.build_api | length == 3
+          - groups.dev | length == 4
+          - groups.launch | length == 6
