+
+
+@pytest.mark.parametrize(
+    ("lines", "expected"),
+    [
+        pytest.param(
+            [
+                "a97e6837f60cec6da4491bab387296bbcd72bdba",
+            ],
+            [("a97e6837f60cec6da4491bab387296bbcd72bdba", "sample.txt")],
+            id="single-line-digest",
