+    )
+    parser.add_argument(
+        '-f',
+        '--force',
+        help='Force the update of the version and history file.',
+        action='store_true',
+    )
+    args = parser.parse_args()
+
+    version = args.version
+    _dry_run = args.dry_run
+    _force_update = args.force
+
+    update_version(version, _dry_run)
