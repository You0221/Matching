+        sibling: 'Foo' = None
+
+    benchmark(rebuild_model, Foo)
+
+
+@pytest.mark.benchmark(group='model_schema_generation_recursive')
+def test_generic_recursive_model_schema_generation(benchmark):
+    T = TypeVar('T')
+
