+        ('python', [10, 20, 30], [10, 20, 30]),
+        ('python', [10, 20, 3], [10, 20]),
+        ('json', '[10, 20, 30]', [10, 20, 30]),
+        ('json', '[10, 20, 30', [10, 20, 30]),
+        ('json', '[10, 20, 3', [10, 20]),
