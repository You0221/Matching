+        (int, validate_as(...).gt(0), [1, 2, 100], [0, -1]),
+        (float, validate_as(...).gt(0.0), [0.1, 1.8], [0.0, -1.0]),
+        (Decimal, validate_as(...).gt(Decimal(0.0)), [Decimal(1)], [Decimal(0.0), Decimal(-1.0)]),
+        (int, validate_as(...).lt(5), [2, 4], [5, 6, 100]),
