+        (Decimal, validate_as(...).ge(Decimal(0.0)), [Decimal(1), Decimal(0.0)], [Decimal(-1.0)]),
+        (int, validate_as(...).le(5), [2, 4], [6, 100]),
+        (float, validate_as(...).le(1.0), [0.5, 0.0], [100.0]),
