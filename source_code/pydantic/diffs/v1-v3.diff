+    TypeVar,
+    Union,
+    get_origin,
+)
+
+import pytest
+from typing_extensions import Annotated, Self
+
+from pydantic import (
+    AfterValidator,
+    BaseModel,
+    BeforeValidator,
+    Discriminator,
+    Field,
+    PlainSerializer,
+    PlainValidator,
+    Tag,
+    WrapSerializer,
+    WrapValidator,
