+            {'type': 'string'},
+            {'type': 'string'},  # see this is still string
+        ),
+        # in juxtaposition to the case above, when we use validate_as (recommended),
+        # the JSON schema is updated appropriately
+        (
+            Annotated[int, validate_as(str).validate_as(int)],
