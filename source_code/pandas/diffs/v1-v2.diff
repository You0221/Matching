+                offsets.MonthBegin(1),
+                offsets.Minute(),
+                np.timedelta64(365, "D"),
+                timedelta(365),
+            ]:
+                with pytest.raises(IncompatibleFrequency, match=msg):
+                    per - off
+
+        # freq is Tick
+        for freq in ["D", "2D", "3D"]:
+            per = Period("2011-04-01", freq=freq)
