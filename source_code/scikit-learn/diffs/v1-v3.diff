+    X, y = datasets.load_iris(return_X_y=True)
+
+    rng = np.random.RandomState(42)
+    X_missing = X.copy()
+    mask = rng.binomial(
+        n=np.ones(shape=(1, 4), dtype=np.int32), p=X[:, [2]] / 8
+    ).astype(bool)
+    X_missing[mask] = np.nan
+    X_train, _, y_train, _ = train_test_split(X_missing, y, random_state=13)
+
