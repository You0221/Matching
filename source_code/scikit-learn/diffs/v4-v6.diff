+plt.legend(
+    bbox_to_anchor=(1.02, 1),
+    loc="upper left",
+    borderaxespad=0,
+)
+
+# Set axis properties
+plt.xticks(n_components)
+plt.ylim((0.85, 1.0))
+
+# # Adjust layout
+plt.tight_layout()
+
