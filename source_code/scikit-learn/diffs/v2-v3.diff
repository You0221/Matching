-    quadraticBezierCurveto | smoothCurve | curve | horizontalLine | verticalLine
-    )
-
-#~ number.debug = True
-moveToDrawToCommands = moveTo + ZeroOrMore(drawToCommand)
-
-path = ZeroOrMore(moveToDrawToCommands)
-path.keepTabs = True
