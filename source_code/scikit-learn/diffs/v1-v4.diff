+      >>> X_train, X_test = X[:200], X[200:]
+      >>> y_train, y_test = y[:200], y[200:]
+      >>> est = GradientBoostingRegressor(
+      ...     n_estimators=100, learning_rate=0.1, max_depth=1, random_state=0,
+      ...     loss='squared_error'
+      ... ).fit(X_train, y_train)
