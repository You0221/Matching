+        """
+        Taken from https://www.rfc-editor.org/rfc/rfc9110.html#section-12.5.1-18.
+        """
+        request = HttpRequest()
+        request.META["HTTP_ACCEPT"] = (
+            "text/*;q=0.3, text/plain;q=0.7, text/plain;format=flowed, "
