+
+msgid "checksum"
+msgstr "تەكشۈرۈش يىغىندىسى"
+
+msgid "block size"
+msgstr "بۆلەك چوڭلۇقى"
+
+msgid "name"
+msgstr "ئىسمى"
+
+msgid "content type"
+msgstr "مەزمۇن تىپى"
+
+msgid "codename"
