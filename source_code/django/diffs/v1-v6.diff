+                "simple_one_default_block - Expected result (content value: inner): "
+                "99, hello",
+            ),
+            (
+                "{% load custom %}{% simple_one_default_block 37 42 %}inner"
+                "{% endsimple_one_default_block %}",
+                "simple_one_default_block - Expected result (content value: inner): "
