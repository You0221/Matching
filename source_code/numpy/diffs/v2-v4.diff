+                    "bit_generator", "ctypeslib", "lapack_lite",
+                ] and  # skip modules
+                "numpy._core" not in member.__name__ and  # outside _core
+                member not in visited_modules  # not visited yet
+            ):
+                modules_queue.append(member)
+                visited_modules.add(member)
+            elif (
