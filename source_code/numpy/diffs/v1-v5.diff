-	(getcharbufferproc)array_getcharbuf,    /*bf_getcharbuffer*/
-    #endif
-    #endif
-    #if PY_VERSION_HEX >= 0x02060000
-	(getbufferproc)array_getbuffer,         /*bf_getbuffer*/
-	(releasebufferproc)array_releasebuffer, /*bf_releasebuffer*/
-    #endif
-    };
