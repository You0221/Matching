+
+#ifndef _NPY_SIMD_LSX_CVT_H
+#define _NPY_SIMD_LSX_CVT_H
+
+// convert mask types to integer types
+#define npyv_cvt_u8_b8(BL)   BL
+#define npyv_cvt_s8_b8(BL)   BL
