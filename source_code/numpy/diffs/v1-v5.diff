+// vector with zero lanes
+#define npyv_zero_u8()  __lsx_vldi(0)
+#define npyv_zero_s8()  __lsx_vldi(0)
+#define npyv_zero_u16() __lsx_vldi(0)
+#define npyv_zero_s16() __lsx_vldi(0)
+#define npyv_zero_u32() __lsx_vldi(0)
