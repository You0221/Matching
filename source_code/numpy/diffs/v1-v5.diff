+def test_temp_elision_thread_safety():
+    amid = np.ones(50000)
+    bmid = np.ones(50000)
+    alarge = np.ones(1000000)
+    blarge = np.ones(1000000)
+
+    def func(count):
+        if count % 4 == 0:
+            (amid * 2) + bmid
+        elif count % 4 == 1:
+            (amid + bmid) - 2
+        elif count % 4 == 2:
+            (alarge * 2) + blarge
+        else:
+            (alarge + blarge) - 2
+
+    run_threaded(func, 100, pass_count=True)
+
+
