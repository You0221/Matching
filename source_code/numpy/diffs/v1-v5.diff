-    const npyv_f32 codyw_pio2_medf = npyv_setall_f32(-0x1.5110b4p-22f);
-    const npyv_f32 codyw_pio2_lowf = npyv_setall_f32(-0x1.846988p-48f);
-    const npyv_f32 rint_cvt_magic = npyv_setall_f32(0x1.800000p+23f);
