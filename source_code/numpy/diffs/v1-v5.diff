+        }
+
+        double bufsize = size;
+        if (bufsize > maximum_size &&
+                (cost > 1 || !(itflags & NPY_ITFLAG_GROWINNER))) {
+            /* If we need buffering, limit size in cost calculation. */
+            bufsize = maximum_size;
+        }
