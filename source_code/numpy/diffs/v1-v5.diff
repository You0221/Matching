+        /*
+         * Compare cost (use double to avoid overflows), as explained above
+         * the cost is compared via the other buffersize.
+         */
+        if (cost * (double)best_size <= best_cost * bufsize) {
+            /* This dimension is better! */
+            best_cost = cost;
+            best_coresize = coresize;
+            best_size = size;
+            best_dim = idim;
+        }
