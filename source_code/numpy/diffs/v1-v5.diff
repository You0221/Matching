-        (ssizeobjargproc)0,                         /* sq_ass_item */
-        (void *)0,                                  /* nee sq_ass_slice */
-        (objobjproc)0,                              /* sq_contains */
-        (binaryfunc)0,                              /* sq_inplace_concat */
-        (ssizeargfunc)0                             /* sq_inplace_repeat */
-    };
-
