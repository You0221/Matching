+
+#ifndef _NPY_SIMD_LSX_ARITHMETIC_H
+#define _NPY_SIMD_LSX_ARITHMETIC_H
+
+/***************************
+ * Addition
+ ***************************/
+// non-saturated
+#define npyv_add_u8  __lsx_vadd_b
+#define npyv_add_s8  __lsx_vadd_b
+#define npyv_add_u16 __lsx_vadd_h
