+        npy_intp len = string_pad(buf, *(npy_int64 *)in2, *fill, pos, outbuf);
+        if (len < 0) {
+            return -1;
+        }
+        outbuf.buffer_fill_with_zeros_after_index(len);
+
+        in1 += strides[0];
+        in2 += strides[1];
+        in3 += strides[2];
+        out += strides[3];
+    }
+
+    return 0;
+}
