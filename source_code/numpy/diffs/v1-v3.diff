+typedef struct npy_interned_str_struct {
+    PyObject *current_allocator;
+    PyObject *array;
+    PyObject *array_function;
+    PyObject *array_struct;
+    PyObject *array_priority;
+    PyObject *array_interface;
+    PyObject *array_wrap;
