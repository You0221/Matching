+    // then we iterate through the map's keys to get the unique values
+    T* data = (T *)PyArray_DATA((PyArrayObject *)res_obj);
+    auto it = hashset.begin();
+    size_t i = 0;
+    for (; it != hashset.end(); it++, i++) {
+        data[i] = *it;
+    }
+
+    return res_obj;
