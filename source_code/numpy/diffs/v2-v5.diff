+NPY_FINLINE npyv_f64x2 npyv_unzip_f64(__m128d a, __m128d b)
+{
+    npyv_f64x2 r;
+    r.val[0] = (__m128d)(__lsx_vpickev_d((__m128i)b, (__m128i)a));
+    r.val[1] = (__m128d)(__lsx_vpickod_d((__m128i)b, (__m128i)a));
