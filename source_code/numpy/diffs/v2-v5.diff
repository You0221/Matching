+    assert(nlane > 0);
+    if (nlane == 1) {
+        const __m128i vfill = npyv_setall_s64(fill);
+        return __lsx_vinsgr2vr_d(vfill, ptr[0], 0);
+    }
+    return npyv_loadn_s64(ptr, stride);
