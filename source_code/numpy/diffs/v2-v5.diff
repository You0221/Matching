+NPY_FINLINE void npyv_storen_s32(npy_int32 *ptr, npy_intp stride, npyv_s32 a)
+{
+
+    __lsx_vstelm_w(a, ptr, 0, 0);
+    __lsx_vstelm_w(a, ptr + stride, 0, 1);
+    __lsx_vstelm_w(a, ptr + stride*2, 0, 2);
